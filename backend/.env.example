# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Connect as the restricted costume_app role created by 003_app_role.sql.
DATABASE_URL=postgresql://costume_app:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DATABASE_SSL=true

# Exact origins allowed to call this API. Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173

# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Supabase Storage. Required in production. The service key is server-side
# only and must never appear in the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=costume-photos

# Leave SUPABASE_* unset locally to store uploads in this folder instead.
LOCAL_STORAGE_DIR=.local-storage

# Resend. Required in production.
RESEND_API_KEY=
MAIL_FROM=Costume Competition <noreply@yourdomain.example>

# Development only: print verification codes to the server log instead of
# emailing them. The server refuses to start with this on in production.
DEV_EMAIL_TO_CONSOLE=true

STUDENT_EMAIL_DOMAIN=education.nsw.gov.au
