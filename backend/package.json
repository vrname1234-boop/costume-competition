{
  "name": "costume-competition-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for the school costume competition platform",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "seed:owner": "tsx scripts/seed-owner.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "argon2": "0.41.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "file-type": "16.5.4",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.0.2",
    "pg": "8.12.0",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "resend": "4.0.0",
    "sharp": "0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "20.16.10",
    "@types/pg": "8.11.10",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
